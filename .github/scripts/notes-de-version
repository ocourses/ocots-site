#!/usr/bin/env python3
"""Extrait de CHANGELOG.md la section d'une version, pour la release GitHub.

    .github/scripts/notes-de-version v0.1.0 > notes.md

Sortie 1 si la section `## vX.Y.Z` est absente : on ne publie pas une version
que le CHANGELOG ne décrit pas. Sortie 1 aussi si « ## Non publié » a encore des
entrées : le tag porte alors des changements que les notes ne décrivent pas
(tag posé après le commit de release).
"""

import re
import sys


def section(changelog, version):
    m = re.search(rf"^## {re.escape(version)}(?=\s|$).*?\n(.*?)(?=^## |\Z)",
                  changelog, re.M | re.S)
    return m.group(1).strip().rstrip("-").strip() if m else None


def main(argv):
    version = argv[0]
    with open("CHANGELOG.md", encoding="utf-8") as fh:
        changelog = fh.read()
    if section(changelog, "Non publié"):
        print("CHANGELOG.md : « ## Non publié » n'est pas vide, le tag doit porter"
              " sur le commit de release", file=sys.stderr)
        return 1
    notes = section(changelog, version)
    if not notes:
        print(f"CHANGELOG.md : aucune section « ## {version} »", file=sys.stderr)
        return 1
    print(notes)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
